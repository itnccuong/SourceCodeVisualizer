  "scripts": {
      "install": "cd ./vscodeextension; npm install"
    , "package_vscodeExt": "npm --prefix vscodeextension run package"
    , "copy_release_files":   "cp ./vscodeextension/release/* ../release/"

    , "compile":     "npm run package_vscodeExt"
    , "postcompile": "npm run copy_release_files"
    , "publish":     "npm run compile"
  }

}