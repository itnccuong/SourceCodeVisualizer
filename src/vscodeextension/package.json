{
  "publisher": "itnccuong",
  "name": "source-code-visualizer",
  "version": "0.2.2",
  "displayName": "Source Code Visualizer (Fork)",
  "description": "Explore code and YAML as connected diagrams, with syntax-aware parsing, comment controls, and saved canvases.",
  "private": true,
  "homepage": "https://github.com/itnccuong/SourceCodeVisualizer#readme",
  "keywords": [
    "visualization",
    "visualize",
    "software exploration",
    "diagram",
    "program comprehension"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/itnccuong/SourceCodeVisualizer",
    "directory": "src/vscodeextension"
  },
  "bugs": {
    "url": "https://github.com/itnccuong/SourceCodeVisualizer/issues"
  },
  "engines": {
    "vscode": "^1.44.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "icon": "icon.png",
  "main": "./out/extension_main.js",
  "contributes": {
    "commands": [
      {
        "command": "source-code-visualizer.visualize",
        "title": "Visual Programming: Visualize This"
      },
      {
        "command": "source-code-visualizer.visualize.fromContextMenu",
        "title": "Visualize This"
      },
      {
        "command": "source-code-visualizer.visualize.fromExplorer",
        "title": "Visualize This"
      },
      {
        "command": "source-code-visualizer.visualizeFile",
        "title": "Visual Programming: Visualize File"
      },
      {
        "command": "source-code-visualizer.saveCanvas",
        "title": "Visual Programming: Save Canvas"
      },
      {
        "command": "source-code-visualizer.loadCanvas",
        "title": "Visual Programming: Load from Canvas"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "source-code-visualizer.visualize.fromContextMenu"
        }
      ],
      "explorer/context": [
        {
          "command": "source-code-visualizer.visualize.fromExplorer",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "source-code-visualizer.visualize.fromExplorer",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run prepare:release",
    "build_dependencies": "cd ../web_visualizer && npm run compile",
    "get_dependencies": "cp -f ../web_visualizer/release/* ./media/",
    "precompile": "npm run build_dependencies && npm run get_dependencies",
    "compile": "tsc -p ./",
    "lint": "eslint src",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/main.js",
    "prepare:release": "node scripts/prepare-release.js",
    "package": "vsce package --no-yarn --baseContentUrl https://github.com/itnccuong/SourceCodeVisualizer/blob/main/src/vscodeextension --baseImagesUrl https://raw.githubusercontent.com/itnccuong/SourceCodeVisualizer/main/src/vscodeextension -o ./release/source-code-visualizer.vsix"
  },
  "dependencies": {
    "@lezer/common": "1.5.5",
    "@lezer/python": "1.1.19",
    "typescript-parser": "npm:typescript@3.9.10",
    "yaml": "1.10.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.44.0",
    "@typescript-eslint/parser": "^8.72.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^10.15.0",
    "glob": "^14.0.6",
    "mocha": "^12.0.3",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "glob": "$glob",
    "minimatch": "^11.0.1"
  }
}
